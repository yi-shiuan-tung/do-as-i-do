+++ b/scripts/scripts_test_video/hawor_video.py
@@ -34,7 +34,16 @@ def load_hawor(checkpoint_path):
         model_cfg.MODEL.BBOX_SHAPE = [192,256]
         model_cfg.freeze()
 
-    model = HAWOR.load_from_checkpoint(checkpoint_path, strict=False, cfg=model_cfg)
+    # The checkpoint embeds OmegaConf metadata. Keep PyTorch's restricted loader
+    # and allow only these configuration types for this one load operation.
+    from typing import Any
+    from omegaconf import DictConfig, ListConfig
+    from omegaconf.base import Metadata, ContainerMetadata
+    from omegaconf.nodes import AnyNode
+    config_types = [DictConfig, ListConfig, Metadata, ContainerMetadata,
+                    AnyNode, dict, list, int, Any, defaultdict]
+    with torch.serialization.safe_globals(config_types):
+        model = HAWOR.load_from_checkpoint(checkpoint_path, strict=False, cfg=model_cfg)
     return model, model_cfg
 
 
